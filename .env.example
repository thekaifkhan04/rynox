# --- Database (local: docker compose up -d; production: Neon pooled URL) ---
DATABASE_URL="postgresql://events:events@localhost:5434/events"

# Connections each server instance may open. Keep it small on serverless hosting.
DATABASE_POOL_MAX="10"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="RYNOX"

# --- Auth (Better Auth + Google) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Google Cloud Console > Credentials > OAuth client (Web).
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# The first account to sign in becomes an admin automatically.
# Optional: comma-separated emails that are always admins.
ADMIN_EMAILS=""

# --- Razorpay (use test keys in development) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard > Webhooks > secret. Webhook URL: <APP_URL>/api/razorpay/webhook
# Events: payment.captured, order.paid, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=""

# --- Email: "resend", "smtp" (Zoho or any SMTP), or "console" (logs only) ---
EMAIL_PROVIDER="console"
EMAIL_FROM="RYNOX <tickets@example.com>"
RESEND_API_KEY=""
# Zoho: smtp.zoho.in (or smtp.zoho.com), port 465, your mailbox and an app password.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Google Sheets sync (optional) ---
# A Google Cloud service account with the Google Sheets API enabled. Each
# event's sheet must be shared with this email as an Editor.
GOOGLE_SHEETS_CLIENT_EMAIL=""
# The "private_key" from the service account's JSON key, on one line with \n kept as written.
GOOGLE_SHEETS_PRIVATE_KEY=""

# --- Image uploads (optional). Without it the admin pastes image URLs. ---
BLOB_READ_WRITE_TOKEN=""

# --- Development only (ignored in production) ---
# Sign in with any email, without Google. Handy before OAuth is set up.
ALLOW_DEV_LOGIN="false"
